# Background helper: writes messages with the AI, sends email, reads replies, sends alerts, finds leads.
# It is a separate service on purpose: restarting the website never interrupts a job that is running.
# Filled in by setup_vps.sh: @@APP_NAME@@ @@APP_USER@@ @@APP_DIR@@ @@NODE_BIN@@
[Unit]
Description=@@APP_NAME@@ background helper (worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@@APP_USER@@
Group=@@APP_USER@@
WorkingDirectory=@@APP_DIR@@
Environment=NODE_ENV=production
ExecStartPre=/usr/bin/touch @@APP_DIR@@/.env
EnvironmentFile=-@@APP_DIR@@/.env
ExecStart=@@NODE_BIN@@ @@APP_DIR@@/worker/index.mjs
# Stop every child process together with the worker.
KillMode=control-group
Restart=always
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
SyslogIdentifier=@@APP_NAME@@-worker

[Install]
WantedBy=multi-user.target
