# n8n (the lead finders). ONE copy is shared by every project on this server, so it is not named after this app.
# setup_vps.sh only creates this file when it does not exist yet. It never changes an existing n8n service.
# Filled in by setup_vps.sh: @@N8N_USER@@ @@N8N_DATA@@ @@N8N_PORT@@ @@N8N_TIMEZONE@@ @@N8N_BIN@@
# Extra settings (WEBHOOK_URL, N8N_ENCRYPTION_KEY and so on) go in @@N8N_DATA@@/n8n.env, not here.
[Unit]
Description=n8n (shared workflow automation)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@@N8N_USER@@
Group=@@N8N_USER@@
WorkingDirectory=@@N8N_DATA@@
Environment=N8N_USER_FOLDER=@@N8N_DATA@@
Environment=N8N_PORT=@@N8N_PORT@@
Environment=N8N_LISTEN_ADDRESS=127.0.0.1
Environment=GENERIC_TIMEZONE=@@N8N_TIMEZONE@@
Environment=TZ=@@N8N_TIMEZONE@@
Environment=N8N_DIAGNOSTICS_ENABLED=false
Environment=N8N_VERSION_NOTIFICATIONS_ENABLED=false
EnvironmentFile=-@@N8N_DATA@@/n8n.env
ExecStart=@@N8N_BIN@@ start
Restart=always
RestartSec=5
TimeoutStopSec=60
LimitNOFILE=65535
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
SyslogIdentifier=n8n

[Install]
WantedBy=multi-user.target
